{# Rendered equivalent of apps/postgres/postgres-primary-standby.yaml from
   the Terraform project. Structure and behavior are unchanged from that
   file; the only fix is that POSTGRES_USER/POSTGRES_PASSWORD now come from
   ansible-vault (vault_postgres_plain_*) instead of being committed in
   plaintext, and the shared pg_hba.conf / initContainer script are written
   once here and reused for both roles via the postgres_plain_roles loop
   (see roles/app_postgres_plain/defaults/main.yml) instead of being
   duplicated twice by hand.

   For the full historical rationale behind the extension-install
   initContainer (why each package/library is there, the libcurl runtime
   dependency chain, the exact verification steps against postgres:17), see
   the original file's comments — carried over in condensed form below. #}
{% set pg_hba_conf %}
# TYPE  DATABASE  USER  ADDRESS          METHOD
local   all       all                    trust
host    all       all   127.0.0.1/32     trust
host    all       all   ::1/128          trust

# Trusted LAN / gateway hosts — password-authenticated, not open trust
host    all       all   192.168.1.0/24   scram-sha-256
host    all       all   172.19.64.1/32   scram-sha-256

# Replication
local   replication  all                 trust
host    replication  all  127.0.0.1/32   trust
host    replication  all  ::1/128        trust

# Everything else: password required
host    all       all   all              scram-sha-256
{% endset %}
{% set install_extensions_script %}
set -euo pipefail
apt-get update -qq
apt-get install -y --no-install-recommends \
  curl ca-certificates gnupg lsb-release apt-transport-https \
  postgresql-plpython3-17 postgresql-17-pldebugger
curl -sL https://install.citusdata.com/community/deb.sh | bash
apt-get update -qq
apt-get install -y --no-install-recommends postgresql-17-citus-14.2
mkdir -p /pyext/pglib /pyext/ext /pyext/pylib /pyext/pyetc /pyext/rtlib
cp -a /usr/lib/postgresql/17/lib/. /pyext/pglib/
cp -a /usr/share/postgresql/17/extension/. /pyext/ext/
cp -a /usr/lib/python3.13/. /pyext/pylib/
cp -a /etc/python3.13/. /pyext/pyetc/
cp -a /usr/lib/x86_64-linux-gnu/libpython3.13.so* \
      /usr/lib/x86_64-linux-gnu/libexpat.so* /pyext/rtlib/
# citus.so needs libcurl at runtime (plus libcurl's own dependency chain not
# already in the base image); the rest of libcurl's ldd output is already
# present in postgres:17 for psql's own TLS/Kerberos/LDAP support. See
# apps/postgres/postgres-primary-standby.yaml in the (now-retired) Terraform
# project for the full verification history of this exact list.
cp -a /usr/lib/x86_64-linux-gnu/libcurl.so* \
      /usr/lib/x86_64-linux-gnu/libnghttp2.so* \
      /usr/lib/x86_64-linux-gnu/libnghttp3.so* \
      /usr/lib/x86_64-linux-gnu/libpsl.so* \
      /usr/lib/x86_64-linux-gnu/librtmp.so* \
      /usr/lib/x86_64-linux-gnu/libssh2.so* \
      /usr/lib/x86_64-linux-gnu/libbrotlidec.so* \
      /usr/lib/x86_64-linux-gnu/libbrotlicommon.so* /pyext/rtlib/
{% endset %}
# 1. Namespaces
{% for pg in postgres_plain_roles %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ pg.namespace }}
{% endfor %}

# 2. Credentials — sourced from ansible-vault (vault_postgres_plain_user,
#    vault_postgres_plain_primary_password, vault_postgres_plain_standby_password),
#    not committed in plaintext the way the original Terraform-era manifest did.
{% for pg in postgres_plain_roles %}
---
apiVersion: v1
stringData:
  POSTGRES_DB: {{ postgres_plain_db }}
  POSTGRES_PASSWORD: {{ pg.password }}
  POSTGRES_USER: {{ vault_postgres_plain_user }}
kind: Secret
metadata:
  name: postgres-{{ pg.name }}-credentials
  namespace: {{ pg.namespace }}
type: Opaque
{% endfor %}

# 3. pg_hba.conf — declared here instead of hand-edited in the running pod,
#    so it survives pod/PVC recreation and changes go through this playbook.
#    Mounted as a directory (not subPath) so ConfigMap edits actually
#    propagate into the pod; Postgres still needs a reload to pick them up:
#      kubectl exec -n postgres-primary postgres-primary-0 -- \
#        psql -U <user> -c "SELECT pg_reload_conf();"
{% for pg in postgres_plain_roles %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-{{ pg.name }}-hba
  namespace: {{ pg.namespace }}
data:
  pg_hba.conf: |
{{ pg_hba_conf | indent(4, first=True) }}
{% endfor %}

# 4. PVCs
{% for pg in postgres_plain_roles %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-{{ pg.name }}-data
  namespace: {{ pg.namespace }}
spec:
  accessModes: ["ReadWriteOnce"]
  storageClassName: {{ postgres_plain_storage_class }}
  resources:
    requests:
      storage: {{ postgres_plain_storage_size }}
{% endfor %}

# 5. StatefulSets. Each install-extensions initContainer apt-get installs
#    postgresql-plpython3-17, postgresql-17-pldebugger and Citus into a
#    shared emptyDir, then the main container mounts that staged content
#    back over the real lib/extension/python directories. See the header
#    comment above and the original apps/postgres/postgres-primary-standby.yaml
#    for the full rationale.
{% for pg in postgres_plain_roles %}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres-{{ pg.name }}
  namespace: {{ pg.namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgres-{{ pg.name }}
  template:
    metadata:
      labels:
        app: postgres-{{ pg.name }}
    spec:
      # Pins the pod to the same non-root "postgres" user (uid/gid 999) the
      # official image already drops to internally via gosu — satisfies the
      # "restricted" PodSecurity standard instead of starting as root.
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        # Default fsGroupChangePolicy ("Always") recursively chmod g+rwX's
        # every file on the PVC on every mount/pod (re)start, which widens
        # server.key (needed if SSL is ever turned on) from 0600 to 0660 —
        # Postgres then refuses to start with "private key file... has group
        # or world access". OnRootMismatch skips that walk once the volume
        # root already has the right group, so a manually-fixed 0600 key
        # actually stays fixed across restarts.
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: install-extensions
          image: postgres:17
          # Needs root to apt-get install — overrides the pod-level uid 999
          # pin above just for this container. No capabilities.drop here:
          # apt-get needs CAP_SETUID/CAP_SETGID (root -> its own "_apt"
          # sandbox user) to fetch packages, so dropping ALL breaks it.
          securityContext:
            runAsNonRoot: false
            runAsUser: 0
            runAsGroup: 0
            allowPrivilegeEscalation: false
          command: ["bash", "-c"]
          args:
            - |
{{ install_extensions_script | indent(14, first=True) }}
          volumeMounts:
            - name: pyext
              mountPath: /pyext
      containers:
        - name: postgres
          image: postgres:17
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          envFrom:
            - secretRef:
                name: postgres-{{ pg.name }}-credentials
          env:
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
            - name: LD_LIBRARY_PATH
              value: /usr/local/lib/pgextra
          # shared_preload_libraries: citus is mandatory for Citus to load at
          # all (and must come first per Citus's own docs when combined with
          # other preloaded libraries); plugin_debugger enables indirect/
          # global pldbgapi debugging.
          args: ["-c", "hba_file=/etc/postgresql/custom/pg_hba.conf", "-c", "shared_preload_libraries=citus,plugin_debugger"]
          ports:
            - containerPort: 5432
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
            - name: hba-config
              mountPath: /etc/postgresql/custom
              readOnly: true
            - name: pyext
              mountPath: /usr/lib/postgresql/17/lib
              subPath: pglib
              readOnly: true
            - name: pyext
              mountPath: /usr/share/postgresql/17/extension
              subPath: ext
              readOnly: true
            - name: pyext
              mountPath: /usr/lib/python3.13
              subPath: pylib
              readOnly: true
            - name: pyext
              mountPath: /etc/python3.13
              subPath: pyetc
              readOnly: true
            - name: pyext
              mountPath: /usr/local/lib/pgextra
              subPath: rtlib
              readOnly: true
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: postgres-{{ pg.name }}-data
        - name: hba-config
          configMap:
            name: postgres-{{ pg.name }}-hba
        - name: pyext
          emptyDir: {}
{% endfor %}

# 6. Services (LoadBalancer; swap to ClusterIP if an external IP from
#    Cilium's pool isn't wanted for one of these)
{% for pg in postgres_plain_roles %}
---
apiVersion: v1
kind: Service
metadata:
  name: postgres-{{ pg.name }}
  namespace: {{ pg.namespace }}
spec:
  selector:
    app: postgres-{{ pg.name }}
  type: {{ pg.service_type }}
  ports:
    - port: {{ pg.service_port }}
      targetPort: 5432
{% endfor %}
