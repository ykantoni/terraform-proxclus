# Copy to .env (same directory as this file) and adjust. Every value here
# already defaults sensibly for this repo's own cluster (see config.py) —
# only set what actually differs in your environment.

# --- LLM: also the Ollama server the "ollama" agent troubleshoots ---
OLLAMA_BASE_URL=http://192.168.1.63:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TEMPERATURE=0

# --- Talos / Kubernetes ---
TALOS_VIP=192.168.1.99
GPU_NODE=192.168.1.201
# Absolute path; defaults to <repo root>/.kube/config
# KUBECONFIG_PATH=/home/yurick/terraform/talos-proxmox/.kube/config

# --- Proxmox host (reached over SSH; needs a working key-based login) ---
PROXMOX_HOST=192.168.1.100
PROXMOX_USER=root
PROXMOX_SSH_PORT=22
# PROXMOX_SSH_KEY=/home/yurick/.ssh/id_ed25519

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowlist, or "*" (the default) since this API carries no
# auth/cookies anyway and the GUI is often opened from a LAN IP, not just
# localhost. Lock this down to specific origins if that matters for you.
CORS_ORIGINS=*
